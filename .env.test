NODE_ENV=development
PORT=5000
HOST=127.0.0.1

# Database Configuration - PostgreSQL Test Container
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/stock_kanban
PGSSL=false
PGPOOL_MAX=5
PGPOOL_IDLE_TIMEOUT_MS=30000

# Frontend
VITE_API_BASE_URL=http://localhost:5000

# Logging
LOG_LEVEL=debug

# User Isolation (allow client-controlled userId for testing)
ENABLE_USER_ISOLATION=false
