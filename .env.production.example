# ═══════════════════════════════════════════════════════════════════
# Stock Kanban - Production Environment Configuration
# ═══════════════════════════════════════════════════════════════════

# ─ Application Settings (required)
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Required in production: app will fail fast if missing
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# ─ Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000
# For external access, use your domain:
# VITE_API_BASE_URL=https://stockkanban.aixintelligence.com

# ─ Database Configuration (required for persistent backtest storage)
# 
# Option 1: Use Docker container managed by stock_kanban_update_and_run.sh
# (leave empty, script will auto-create)
# DATABASE_URL=
#
# Option 2: Use existing PostgreSQL service on same machine
# DATABASE_URL=postgresql://stock_user:stock_pass@localhost:5432/stock_kanban
# PGSSL=false
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000
#
# Option 3: Use remote managed PostgreSQL (RDS, Azure Database, etc.)
# DATABASE_URL=postgresql://USER:PASSWORD@your-host.rds.amazonaws.com:5432/stock_kanban
# PGSSL=true
# PGSSL_REJECT_UNAUTHORIZED=false
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000

# ─ Optional: Logging
LOG_LEVEL=info

# ─ Security: Admin secret for protected endpoints
# This is required for endpoints like /api/live/settle-now
# Set this to a strong random string in production
# You can generate one with: openssl rand -base64 32
# ADMIN_SECRET=your-strong-random-secret-here

# ─ User Isolation: Enable strict user isolation in production
# When true:  only accepts userId from authentication (recommended for production)
# When false: allows client-controlled userId (for local demo/testing only)
# ENABLE_USER_ISOLATION=false

# ═══════════════════════════════════════════════════════════════════
# Notes:
# - If DATABASE_URL is empty, stock_kanban_update_and_run.sh will create
#   a local PostgreSQL container automatically
# - For external database, test connectivity before deployment:
#   docker run --rm -e DATABASE_URL='your_url' postgres:16-alpine pg_isready -d "$DATABASE_URL"
# - All database credentials should be strong and securely managed
# - Consider using AWS Secrets Manager or similar for production
# ═══════════════════════════════════════════════════════════════════
