# EC2 生产环境配置

# 应用
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# 前端配置
VITE_API_BASE_URL=http://localhost:3000

# 可选：数据库（如果需要）
# DATABASE_URL=

# 可选：API 密钥
# YAHOO_FINANCE_API_KEY=

# 可选：日志级别
LOG_LEVEL=info

# PostgreSQL (required for persistent backtest storage)
# Example: postgresql://stock_user:strong_password@127.0.0.1:5432/stock_kanban
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# PGSSL=true
# PGSSL_REJECT_UNAUTHORIZED=false
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000
